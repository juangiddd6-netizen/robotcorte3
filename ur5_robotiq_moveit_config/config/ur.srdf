<?xml version="1.0" encoding="UTF-8"?>
<robot name="ur">
    <!-- GRUPOS DE PLANIFICACION -->
    <group name="gripper">
        <joint name="gripper_finger_joint"/>
        <joint name="right_finger_joint"/>
    </group>
    
    <group name="ur_manipulator">
        <chain base_link="base_link" tip_link="tool0"/>
    </group>

    <!-- POSES PREDEFINIDAS -->
    <group_state name="home" group="ur_manipulator">
        <joint name="elbow_joint" value="0.0"/>
        <joint name="shoulder_lift_joint" value="-1.5708"/>
        <joint name="shoulder_pan_joint" value="0.0"/>
        <joint name="wrist_1_joint" value="-1.5708"/>
        <joint name="wrist_2_joint" value="0.0"/>
        <joint name="wrist_3_joint" value="0.0"/>
    </group_state>

    <group_state name="open" group="gripper">
        <joint name="gripper_finger_joint" value="0.0"/>
        <joint name="right_finger_joint" value="0.0"/>
    </group_state>

    <!-- EFECTOR FINAL -->
    <end_effector name="robotiq_gripper" parent_link="tool0" group="gripper" parent_group="ur_manipulator"/>

    <!-- ARTICULACION VIRTUAL -->
    <virtual_joint name="virtual_joint" type="fixed" parent_frame="world" child_link="base_link"/>

    <!-- MATRIZ DE COLISIONES -->
    <disable_collisions link1="base_link_inertia" link2="shoulder_link" reason="Adjacent"/>
    <disable_collisions link1="forearm_link" link2="upper_arm_link" reason="Adjacent"/>
    <disable_collisions link1="forearm_link" link2="wrist_1_link" reason="Adjacent"/>
    <disable_collisions link1="gripper_base_link" link2="left_finger_link" reason="Adjacent"/>
    <disable_collisions link1="gripper_base_link" link2="right_finger_link" reason="Adjacent"/>
    <disable_collisions link1="gripper_base_link" link2="wrist_1_link" reason="Never"/>
    <disable_collisions link1="gripper_base_link" link2="wrist_2_link" reason="Never"/>
    <disable_collisions link1="gripper_base_link" link2="wrist_3_link" reason="Adjacent"/>
    <disable_collisions link1="left_finger_link" link2="right_finger_link" reason="Never"/>
    <disable_collisions link1="left_finger_link" link2="wrist_1_link" reason="Never"/>
    <disable_collisions link1="left_finger_link" link2="wrist_2_link" reason="Never"/>
    <disable_collisions link1="left_finger_link" link2="wrist_3_link" reason="Never"/>
    <disable_collisions link1="right_finger_link" link2="wrist_1_link" reason="Never"/>
    <disable_collisions link1="right_finger_link" link2="wrist_2_link" reason="Never"/>
    <disable_collisions link1="right_finger_link" link2="wrist_3_link" reason="Never"/>
    <disable_collisions link1="shoulder_link" link2="upper_arm_link" reason="Adjacent"/>
    <disable_collisions link1="wrist_1_link" link2="wrist_2_link" reason="Adjacent"/>
    <disable_collisions link1="wrist_1_link" link2="wrist_3_link" reason="Never"/>
    <disable_collisions link1="wrist_2_link" link2="wrist_3_link" reason="Adjacent"/>
</robot>
